                    <div id="us-bar-neutral" class="bg-gray-700 h-full transition-all duration-300" style="width: 100%"></div>
                    <div id="us-bar-other" class="bg-emerald-600 h-full transition-all duration-300" style="width: 0%"></div>
                    <div id="us-bar-rep" class="bg-rose-600 h-full transition-all duration-300" style="width: 0%"></div>
                    <div class="absolute left-[50%] top-0 bottom-0 w-0.5 bg-amber-400 z-10 shadow-[0_0_10px_#facc15]"></div>
                </div>
            </div>

            <div class="pitch-card rounded-xl p-4 flex-1">
                <div class="flex justify-between items-center mb-3">
                    <span class="text-xs font-semibold tech-font text-gray-400">STAATEN-ZUWEISUNG (⭐ = SWING STATE)</span>
                    <button onclick="resetUSStates()" class="text-xs bg-gray-800 hover:bg-gray-700 px-3 py-1.5 rounded-lg text-gray-300 border border-gray-700">Alle Zurücksetzen (Grau)</button>
                </div>
                <div id="us-states-grid" class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-9 lg:grid-cols-11 gap-2"></div>
            </div>
        </main>
    </div>

    <!-- EDITOR PANEL -->
    <div id="editor-panel" class="fixed inset-y-0 right-0 w-full max-w-md bg-panel border-l border-gray-800 p-6 overflow-y-auto shadow-2xl z-50 transform translate-x-full transition-transform duration-300" data-html2canvas-ignore="true">
        <div class="flex justify-between items-center pb-4 border-b border-gray-800 mb-4">
            <h2 class="text-lg font-bold tech-font text-white">STUDIO EDITOR</h2>
            <button onclick="toggleEditor()" class="text-gray-400 hover:text-white text-xl">✕</button>
        </div>

        <div class="space-y-6">
            <div>
                <h3 class="text-xs font-bold tech-font text-sky-400 uppercase mb-2">Globale Daten</h3>
                <div class="space-y-2">
                    <div>
                        <label class="text-xs text-gray-400">Flagge / Icon</label>
                        <input type="text" id="edit-flag" class="w-full bg-gray-900 border border-gray-800 p-2 text-sm rounded-lg text-white focus:border-sky-500 focus:outline-none" onblur="updateMeta()">
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="text-xs text-gray-400">Auszählungsstand</label>
                            <input type="text" id="edit-progress" class="w-full bg-gray-900 border border-gray-800 p-2 text-sm rounded-lg text-white focus:border-sky-500 focus:outline-none" onblur="updateMeta()">
                        </div>
                        <div>
                            <label class="text-xs text-gray-400">Wahlbeteiligung</label>
                            <input type="text" id="edit-turnout" class="w-full bg-gray-900 border border-gray-800 p-2 text-sm rounded-lg text-white focus:border-sky-500 focus:outline-none" onblur="updateMeta()">
                        </div>
                    </div>
                </div>
            </div>

            <div>
                <h3 class="text-xs font-bold tech-font text-rose-400 uppercase mb-2">Eilmeldungen (Ticker)</h3>
                <textarea id="edit-ticker" rows="3" class="w-full bg-gray-900 border border-gray-800 p-2 text-xs rounded-lg text-white focus:border-sky-500 focus:outline-none" onblur="updateTicker()"></textarea>
            </div>

            <div>
                <div class="flex justify-between items-center mb-2">
                    <h3 id="editor-data-title" class="text-xs font-bold tech-font text-sky-400 uppercase">Einträge Bearbeiten</h3>
                    <button onclick="addParty()" class="text-xs bg-sky-600 hover:bg-sky-500 text-white px-3 py-1.5 rounded-lg shadow">+ Hinzufügen</button>
                </div>
                <div id="editor-parties" class="space-y-3"></div>
            </div>
        </div>
    </div>

