<!DOCTYPE html>
<html lang="de" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TV Wahl-Infografik Studio 2026</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        tech: ['Chakra Petch', 'sans-serif'],
                    },
                    colors: {
                        pitch: '#0B0F19',
                        panel: '#111827',
                        accent: '#38BDF8',
                    }
                }
            }
        }
    </script>
    <style>
        body { background-color: #0B0F19; color: #F3F4F6; font-family: 'Inter', sans-serif; overflow-x: hidden; }
        .tech-font { font-family: 'Chakra Petch', sans-serif; }
        .pitch-card { background: #111827; border: 1px solid rgba(255, 255, 255, 0.08); box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2); }
        
        @keyframes tickerMove {
            0% { transform: translate3d(0, 0, 0); }
            100% { transform: translate3d(-50%, 0, 0); }
        }
        .ticker-wrap { width: 100%; overflow: hidden; background: #E11D48; height: 38px; position: relative; }
        .ticker-move {
            display: inline-flex;
            white-space: nowrap;
            will-change: transform;
            animation: tickerMove 20s linear infinite;
        }
        
        .uk-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block;
            transition: all 0.3s ease;
        }
        
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #0B0F19; }
        ::-webkit-scrollbar-thumb { background: #1F2937; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #374151; }
    </style>
</head>
<body class="min-h-screen flex flex-col">

    <!-- BREAKING NEWS TICKER -->
    <div id="ticker-container" class="ticker-wrap flex items-center shadow-lg z-50">
        <div class="bg-black text-white px-4 h-full flex items-center font-bold text-xs uppercase tracking-widest tech-font flex-shrink-0 z-10 border-r border-rose-800">
            🚨 BREAKING NEWS
        </div>
        <div class="overflow-hidden flex-1 relative flex items-center">
            <div id="ticker-text" class="ticker-move text-white font-semibold text-sm tracking-wide">
                <span class="inline-block px-8">+++ HOCHRECHNUNG 20:00: KOPF-AN-KOPF-RENNEN IN SCHLÜSSELBEZIRKEN +++</span>
                <span class="inline-block px-8">WAHLBETEILIGUNG AUF REKORDNIVEAU +++</span>
                <span class="inline-block px-8">ERSTE HOCHRECHNUNGEN ERWARTET +++</span>
                <span class="inline-block px-8">KOALITIONSVERHANDLUNGEN BEREITS ANGESTOßEN +++</span>
                <span class="inline-block px-8">+++ HOCHRECHNUNG 20:00: KOPF-AN-KOPF-RENNEN IN SCHLÜSSELBEZIRKEN +++</span>
                <span class="inline-block px-8">WAHLBETEILIGUNG AUF REKORDNIVEAU +++</span>
                <span class="inline-block px-8">ERSTE HOCHRECHNUNGEN ERWARTET +++</span>
                <span class="inline-block px-8">KOALITIONSVERHANDLUNGEN BEREITS ANGESTOßEN +++</span>
            </div>
        </div>
    </div>

    <!-- MAIN APP WRAPPER -->
    <div id="export-area" class="flex-1 flex flex-col p-4 md:p-6 max-w-[1920px] mx-auto w-full">
        
        <!-- HEADER -->
        <header class="flex flex-wrap items-center justify-between pb-4 mb-4 border-b border-gray-800 gap-4">
            <div class="flex items-center gap-3">
                <div id="flag-display" class="text-3xl p-1.5 bg-gray-900 rounded-lg border border-gray-800 shadow-inner">🇳🇿</div>
                <div>
                    <h1 class="text-2xl font-bold tech-font tracking-wider text-white uppercase flex items-center gap-2">
                        ELECTIONS STATS 2026 <span class="text-xs px-2 py-0.5 bg-sky-500/10 text-sky-400 rounded border border-sky-500/20 font-sans">GENERAL ELECTION</span>
                    </h1>
                    <p class="text-xs text-gray-400">Auszählungsstand: <span id="display-progress" class="text-sky-400 font-semibold">88.4%</span> | Wahlbeteiligung: <span id="display-turnout" class="text-gray-200">74.2%</span></p>
                </div>
            </div>

            <div class="flex items-center gap-2" data-html2canvas-ignore="true">
                <!-- PARLIAMENT LAYOUT SWITCHER -->
                <button onclick="setParliamentStyle('arc')" id="btn-style-arc" class="px-2.5 py-1.5 text-xs font-semibold rounded tech-font bg-sky-600 text-white border border-sky-400/30 shadow">⭕ HALBKREIS</button>
                <button onclick="setParliamentStyle('westminster')" id="btn-style-uk" class="px-2.5 py-1.5 text-xs font-semibold rounded tech-font bg-gray-800 hover:bg-gray-700 text-gray-300 border border-gray-700">🇬🇧 WESTMINSTER</button>
                
                <div class="h-4 w-[1px] bg-gray-800 mx-1"></div>

                <button onclick="setMode('parliament')" id="btn-parliament" class="px-3 py-1.5 text-xs font-semibold rounded tech-font bg-sky-600 text-white shadow">PARLAMENT</button>
                <button onclick="setMode('presidential')" id="btn-presidential" class="px-3 py-1.5 text-xs font-semibold rounded tech-font bg-gray-800 hover:bg-gray-700 text-gray-300 border border-gray-700">PRÄSIDENT</button>
                <button onclick="setMode('us')" id="btn-us" class="px-3 py-1.5 text-xs font-semibold rounded tech-font bg-gray-800 hover:bg-gray-700 text-gray-300 border border-gray-700">US-WAHL</button>
                <button onclick="toggleEditor()" class="px-3 py-1.5 text-xs font-semibold rounded tech-font bg-amber-600/80 hover:bg-amber-600 text-white ml-2 shadow">⚙️ EDITOR</button>
                <button onclick="export4K()" class="px-3 py-1.5 text-xs font-semibold rounded tech-font bg-emerald-600 hover:bg-emerald-500 text-white shadow">📸 4K EXPORT</button>
            </div>
        </header>

        <!-- PARLIAMENT & PRESIDENTIAL VIEW -->
