                                </div>
                                <div class="flex flex-col gap-1 bg-gray-900/60 p-3 rounded-lg border border-gray-800">
                                    <span class="text-[10px] font-bold tech-font text-gray-400 tracking-wider">RESTLICHE PARTEIEN / OPPOSITION</span>
                                    <div id="uk-coalition-opp-grid" class="flex flex-wrap gap-1.5 items-center"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <!-- US ELECTION VIEW -->
        <main id="view-us" class="hidden flex-1 flex-col gap-6">
            <div class="pitch-card rounded-xl p-6">
                <div class="flex justify-between text-sm font-bold tech-font mb-2">
                    <span class="text-blue-400 text-lg">DEMOKRATEN: <span id="us-dem-votes">0</span></span>
                    <span class="text-amber-400">270 ZUR MEHRHEIT (TOTAL 538)</span>
                    <span class="text-rose-400 text-lg">REPUBLIKANER: <span id="us-rep-votes">0</span></span>
                </div>
                <div class="w-full bg-gray-900 h-8 rounded-lg overflow-hidden flex relative border border-gray-800 shadow-inner">
