                document.getElementById('main-westminster-wrapper').classList.add('hidden');
                document.getElementById('main-westminster-wrapper').classList.remove('flex');

                document.getElementById('coalition-arc-wrapper').classList.remove('hidden');
                document.getElementById('coalition-westminster-wrapper').classList.add('hidden');
                document.getElementById('coalition-westminster-wrapper').classList.remove('flex');
            } else {
                document.getElementById('main-arc-wrapper').classList.add('hidden');
                document.getElementById('main-westminster-wrapper').classList.remove('hidden');
                document.getElementById('main-westminster-wrapper').classList.add('flex');

                document.getElementById('coalition-arc-wrapper').classList.add('hidden');
                document.getElementById('coalition-westminster-wrapper').classList.remove('hidden');
                document.getElementById('coalition-westminster-wrapper').classList.add('flex');
            }
            renderAll(true);
        }

        function setMode(mode) {
            currentMode = mode;
            document.getElementById('btn-parliament').className = mode === 'parliament' ? 'px-3 py-1.5 text-xs font-semibold rounded tech-font bg-sky-600 text-white shadow' : 'px-3 py-1.5 text-xs font-semibold rounded tech-font bg-gray-800 hover:bg-gray-700 text-gray-300 border border-gray-700';
            document.getElementById('btn-presidential').className = mode === 'presidential' ? 'px-3 py-1.5 text-xs font-semibold rounded tech-font bg-sky-600 text-white shadow' : 'px-3 py-1.5 text-xs font-semibold rounded tech-font bg-gray-800 hover:bg-gray-700 text-gray-300 border border-gray-700';
            document.getElementById('btn-us').className = mode === 'us' ? 'px-3 py-1.5 text-xs font-semibold rounded tech-font bg-sky-600 text-white shadow' : 'px-3 py-1.5 text-xs font-semibold rounded tech-font bg-gray-800 hover:bg-gray-700 text-gray-300 border border-gray-700';

            if (mode === 'us') {
                document.getElementById('view-standard').classList.add('hidden');
                document.getElementById('view-us').classList.remove('hidden');
                document.getElementById('view-us').classList.add('flex');
            } else {
                document.getElementById('view-us').classList.add('hidden');
                document.getElementById('view-us').classList.remove('flex');
                document.getElementById('view-standard').classList.remove('hidden');

                document.getElementById('parliament-section').style.display = mode === 'parliament' ? 'flex' : 'none';
                document.getElementById('coalition-section').style.display = mode === 'parliament' ? 'flex' : 'none';
            }
            renderAll(true);
        }

        function renderAll(fullRender = false) {
            renderBarsAndIdeology();
            if (currentMode === 'parliament') {
                if (parliamentStyle === 'arc') {
                    renderParliamentChart(fullRender);
                } else {
                    renderWestminsterMainGrid();
                }
                renderBlocks();
                renderCoalitionButtonsAndChart(fullRender);
            } else if (currentMode === 'us') {
                renderUSGrid();
            }
            if (fullRender || !document.activeElement.matches('#editor-parties input, #editor-parties textarea')) {
                renderPartyEditor();
            }
        }

        function renderBarsAndIdeology() {
            const data = getActiveData();
            const barsContainer = document.getElementById('bars-container');
            const ideologyContainer = document.getElementById('ideology-container');
            
            barsContainer.style.gridTemplateColumns = `repeat(${data.length}, minmax(0, 1fr))`;
            ideologyContainer.style.gridTemplateColumns = `repeat(${data.length}, minmax(0, 1fr))`;

            barsContainer.innerHTML = '';
            ideologyContainer.innerHTML = '';

            const maxPct = Math.max(...data.map(p => p.pct), 1);

            data.forEach(p => {
                const heightPct = Math.max((p.pct / maxPct) * 100, 15);

                const barItem = document.createElement('div');
                barItem.className = 'flex flex-col items-center justify-end h-full w-full';
                barItem.innerHTML = `
                    <div class="w-full max-w-[76px] flex flex-col justify-between p-2 text-center text-white font-bold text-sm tech-font rounded-t-md shadow-lg transition-all duration-300 relative" 
                         style="height: ${heightPct}%; background-color: ${p.color};">
                        <span>${p.pct}%</span>
                        ${p.blockShort ? `<div class="text-[9px] font-black uppercase tracking-wider bg-black/40 px-1.5 py-0.5 rounded text-gray-200 mt-auto border border-white/10">${p.blockShort}</div>` : ''}
                    </div>
                `;
                barsContainer.appendChild(barItem);

                const isDiffPos = p.diff.startsWith('+');
                const diffColor = isDiffPos ? 'text-emerald-400' : 'text-rose-400';

                const ideologyItem = document.createElement('div');
                ideologyItem.className = 'flex flex-col items-center gap-1.5 w-full';
                ideologyItem.innerHTML = `
                    <div class="text-xs font-semibold ${diffColor} tech-font">${p.diff}</div>
                    ${p.img ? `<img src="${p.img}" class="w-9 h-9 rounded-full object-cover border border-white/20 shadow">` : ''}
                    <div class="font-bold text-xs text-white tech-font tracking-wide break-words w-full">${p.name}</div>
                    <div class="text-[10px] font-bold px-2.5 py-0.5 rounded-md text-white shadow-sm break-words max-w-full" style="background-color: ${p.color}">${p.short}</div>
                    <div class="text-[11px] text-gray-400 leading-snug break-words whitespace-normal w-full mt-1 font-medium">
                        ${p.ideology.replace(/\n/g, '<br>')}
                    </div>
                `;
                ideologyContainer.appendChild(ideologyItem);
            });
        }

        function renderWestminsterMainGrid() {
            const govGrid = document.getElementById('uk-main-gov-grid');
            const oppGrid = document.getElementById('uk-main-opp-grid');
            govGrid.innerHTML = '';
            oppGrid.innerHTML = '';

            const sorted = [...parliamentParties].sort((a, b) => b.seats - a.seats);
            const govParties = sorted.filter(p => p.coalition);
            const oppParties = sorted.filter(p => !p.coalition);

            govParties.forEach(p => {
                for (let i = 0; i < p.seats; i++) {
                    const dot = document.createElement('div');
                    dot.className = 'uk-dot shadow-sm';
                    dot.style.backgroundColor = p.color;
                    dot.title = `${p.short} (${p.seats} Sitze)`;
                    govGrid.appendChild(dot);
                }
            });

            oppParties.forEach(p => {
                for (let i = 0; i < p.seats; i++) {
                    const dot = document.createElement('div');
                    dot.className = 'uk-dot shadow-sm';
                    dot.style.backgroundColor = p.color;
                    dot.title = `${p.short} (${p.seats} Sitze)`;
                    oppGrid.appendChild(dot);
                }
            });
        }

        function renderParliamentChart(fullRebuild = false) {
            const ctx = document.getElementById('parliamentChart').getContext('2d');
            const dataSeats = parliamentParties.map(p => p.seats);
            const colors = parliamentParties.map(p => p.color);

            if (!parliamentChartInstance || fullRebuild) {
                if (parliamentChartInstance) parliamentChartInstance.destroy();
                parliamentChartInstance = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        datasets: [{
                            data: dataSeats,
                            backgroundColor: colors,
                            borderWidth: 0,
                        }]
                    },
                    options: {
                        rotation: -90,
                        circumference: 180,
                        cutout: '48%',
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: { duration: 400 },
                        plugins: { legend: { display: false } }
                    }
                });
            } else {
                parliamentChartInstance.data.datasets[0].data = dataSeats;
                parliamentChartInstance.data.datasets[0].backgroundColor = colors;
                parliamentChartInstance.update();
            }
        }

        function renderBlocks() {
            const container = document.getElementById('block-container');
            container.innerHTML = '';

            const blockMap = {};

            parliamentParties.forEach(p => {
                const blockName = (p.block && p.block.trim() !== '') ? p.block.trim() : 'Sonstige';
                if (!blockMap[blockName]) {
                    blockMap[blockName] = { seats: 0, parties: [] };
                }
                blockMap[blockName].seats += p.seats;
                blockMap[blockName].parties.push(p);
            });

            Object.keys(blockMap).forEach(blockName => {
                const b = blockMap[blockName];
                const strongestParty = [...b.parties].sort((x, y) => y.seats - x.seats)[0];

                const blockBadge = document.createElement('div');
                blockBadge.className = 'px-4 py-2 rounded-lg text-white font-bold text-xs tech-font flex items-center gap-2 border border-white/10 shadow-lg uppercase tracking-wider';
                blockBadge.style.backgroundColor = strongestParty.color;
                blockBadge.innerHTML = `<span>${blockName}: ${b.seats} SITZE</span>`;
                container.appendChild(blockBadge);
            });
        }

        function renderCoalitionButtonsAndChart(fullRebuild = false) {
            const container = document.getElementById('coalition-buttons');
            const blockQuickSelect = document.getElementById('coalition-block-quickselect');
            container.innerHTML = '';
            blockQuickSelect.innerHTML = '';

            let totalSelectedSeats = 0;
            const maxSeats = parliamentParties.reduce((a, b) => a + b.seats, 0);
            const majorityThreshold = Math.floor(maxSeats / 2) + 1;

            const blockNames = [...new Set(parliamentParties.map(p => (p.block && p.block.trim() !== '') ? p.block.trim() : 'Sonstige'))];

            blockNames.forEach(bName => {
                const bParties = parliamentParties.filter(p => ((p.block && p.block.trim() !== '') ? p.block.trim() : 'Sonstige') === bName);
                const allSelected = bParties.every(p => p.coalition);
                const strongest = [...bParties].sort((x, y) => y.seats - x.seats)[0];

                const quickBtn = document.createElement('button');
                quickBtn.onclick = () => {
                    bParties.forEach(p => p.coalition = !allSelected);
                    renderAll(false);
                };
                quickBtn.className = `px-3 py-1.5 rounded-lg text-[11px] font-bold tech-font border transition-all shadow-sm ${allSelected ? 'border-sky-400 ring-2 ring-sky-400/40 text-white' : 'border-gray-800 opacity-70 hover:opacity-100 text-gray-300'}`;
                quickBtn.style.backgroundColor = strongest.color;
                quickBtn.innerText = `+ ${bName}`;
                blockQuickSelect.appendChild(quickBtn);
            });

            const cDataSeats = [];
            const cColors = [];

            parliamentParties.forEach(p => {
                if (p.coalition) {
                    totalSelectedSeats += p.seats;
                    cDataSeats.push(p.seats);
                    cColors.push(p.color);
                } else {
                    cDataSeats.push(0);
                    cColors.push(p.color);
                }

                const btn = document.createElement('button');
                btn.onclick = () => {
                    p.coalition = !p.coalition;
                    renderAll(false);
                };
                btn.className = `px-3.5 py-2 rounded-lg text-xs font-bold tech-font transition-all border shadow-sm ${p.coalition ? 'border-sky-400 ring-2 ring-sky-400/50 scale-105' : 'border-gray-800 opacity-40 hover:opacity-70'}`;
                btn.style.backgroundColor = p.color;
                btn.style.color = '#ffffff';
                btn.innerText = `${p.short} (${p.seats})`;
                container.appendChild(btn);
            });

            const remainingSeats = Math.max(maxSeats - totalSelectedSeats, 0);
            cDataSeats.push(remainingSeats);
            cColors.push('rgba(255, 255, 255, 0.05)');

            const statusEl = document.getElementById('coalition-status');
            if (totalSelectedSeats >= majorityThreshold) {
                statusEl.className = 'text-xs font-bold tech-font px-3.5 py-1.5 rounded-lg bg-emerald-950/60 text-emerald-300 border border-emerald-800/60 shadow-[0_0_10px_rgba(16,185,129,0.2)]';
                statusEl.innerText = ` absolute MEHRHEIT ERREICHT (${totalSelectedSeats} / ${majorityThreshold} Sitze)`;
            } else {
                statusEl.className = 'text-xs font-bold tech-font px-3.5 py-1.5 rounded-lg bg-rose-950/60 text-rose-300 border border-rose-800/60';
                statusEl.innerText = `KEINE MEHRHEIT (${totalSelectedSeats} / ${majorityThreshold} Sitze)`;
            }

            if (parliamentStyle === 'arc') {
                const ctx = document.getElementById('coalitionChart').getContext('2d');

                if (!coalitionChartInstance || fullRebuild) {
                    if (coalitionChartInstance) coalitionChartInstance.destroy();
                    coalitionChartInstance = new Chart(ctx, {
                        type: 'doughnut',
                        data: {
                            datasets: [{
                                data: cDataSeats,
                                backgroundColor: cColors,
                                borderWidth: 0,
                            }]
                        },
                        options: {
                            rotation: -90,
                            circumference: 180,
                            cutout: '48%',
                            responsive: true,
                            maintainAspectRatio: false,
                            animation: {
                                duration: 1000,
                                easing: 'easeOutCubic'
                            },
                            plugins: { legend: { display: false } }
                        }
                    });
                } else {
                    coalitionChartInstance.data.datasets[0].data = cDataSeats;
                    coalitionChartInstance.data.datasets[0].backgroundColor = cColors;
                    coalitionChartInstance.update();
                }
            } else {
                const cGovGrid = document.getElementById('uk-coalition-gov-grid');
                const cOppGrid = document.getElementById('uk-coalition-opp-grid');
                cGovGrid.innerHTML = '';
                cOppGrid.innerHTML = '';

                parliamentParties.forEach(p => {
                    if (p.coalition) {
                        for (let i = 0; i < p.seats; i++) {
                            const dot = document.createElement('div');
                            dot.className = 'uk-dot shadow-sm';
                            dot.style.backgroundColor = p.color;
                            cGovGrid.appendChild(dot);
                        }
                    } else {
                        for (let i = 0; i < p.seats; i++) {
                            const dot = document.createElement('div');
                            dot.className = 'uk-dot shadow-sm opacity-40';
                            dot.style.backgroundColor = p.color;
                            cOppGrid.appendChild(dot);
                        }
                    }
                });
            }
        }

        function renderUSGrid() {
            const grid = document.getElementById('us-states-grid');
            grid.innerHTML = '';

            let demTotal = 0, repTotal = 0, otherTotal = 0, neutralTotal = 0;

            usStates.forEach(s => {
                if (s.status === 'dem') demTotal += s.votes;
                else if (s.status === 'rep') repTotal += s.votes;
                else if (s.status === 'other') otherTotal += s.votes;
                else neutralTotal += s.votes;

                const card = document.createElement('div');
                let bgColor = 'bg-gray-900/80 text-gray-400 border-gray-800';
                if (s.status === 'dem') bgColor = 'bg-blue-600 text-white border-blue-400 shadow';
                if (s.status === 'rep') bgColor = 'bg-rose-600 text-white border-rose-400 shadow';
                if (s.status === 'other') bgColor = 'bg-emerald-600 text-white border-emerald-400 shadow';

                const borderStyle = s.swing ? 'border-2 border-amber-400 shadow-[0_0_8px_rgba(245,158,11,0.4)]' : 'border';

                card.className = `p-2 rounded-lg flex flex-col items-center justify-between cursor-pointer select-none transition-all ${bgColor} ${borderStyle}`;
                card.innerHTML = `
                    <div class="flex justify-between w-full text-[10px]">
                        <span class="font-bold">${s.code}</span>
                        <button onclick="toggleSwing('${s.code}', event)" class="hover:scale-125">${s.swing ? '⭐' : '☆'}</button>
                    </div>
                    <div class="text-sm font-black tech-font my-0.5">${s.votes}</div>
                    <div class="flex gap-1 mt-1 w-full" onclick="event.stopPropagation()">
                        <button onclick="setUSStatus('${s.code}', 'dem')" class="flex-1 text-[8px] bg-blue-700 hover:bg-blue-500 rounded py-0.5 font-bold">D</button>
                        <button onclick="setUSStatus('${s.code}', 'neutral')" class="flex-1 text-[8px] bg-gray-700 hover:bg-gray-600 rounded py-0.5 font-bold">N</button>
                        <button onclick="setUSStatus('${s.code}', 'rep')" class="flex-1 text-[8px] bg-rose-700 hover:bg-rose-500 rounded py-0.5 font-bold">R</button>
                    </div>
                `;

                card.onclick = () => {
                    const cycle = { 'neutral': 'dem', 'dem': 'rep', 'rep': 'other', 'other': 'neutral' };
                    s.status = cycle[s.status];
                    renderUSGrid();
                };

                grid.appendChild(card);
            });

            document.getElementById('us-dem-votes').innerText = demTotal;
            document.getElementById('us-rep-votes').innerText = repTotal;

            const total = 538;
            document.getElementById('us-bar-dem').style.width = `${(demTotal / total) * 100}%`;
            document.getElementById('us-bar-rep').style.width = `${(repTotal / total) * 100}%`;
            document.getElementById('us-bar-other').style.width = `${(otherTotal / total) * 100}%`;
            document.getElementById('us-bar-neutral').style.width = `${(neutralTotal / total) * 100}%`;
        }

        function setUSStatus(code, status) {
            const s = usStates.find(x => x.code === code);
            if (s) { s.status = status; renderUSGrid(); }
        }

        function toggleSwing(code, e) {
            e.stopPropagation();
            const s = usStates.find(x => x.code === code);
            if (s) { s.swing = !s.swing; renderUSGrid(); }
        }

        function resetUSStates() {
            usStates.forEach(s => s.status = 'neutral');
            renderUSGrid();
        }

        function toggleEditor() {
            const panel = document.getElementById('editor-panel');
            panel.classList.toggle('translate-x-full');
        }

        function updateMeta() {
            meta.flag = document.getElementById('edit-flag').value;
            meta.progress = document.getElementById('edit-progress').value;
            meta.turnout = document.getElementById('edit-turnout').value;

            document.getElementById('flag-display').innerText = meta.flag || '🌐';
            document.getElementById('display-progress').innerText = meta.progress;
            document.getElementById('display-turnout').innerText = meta.turnout;
        }

        function updateTicker() {
            meta.ticker = document.getElementById('edit-ticker').value;
            const tickerEl = document.getElementById('ticker-text');
            tickerEl.innerHTML = `
                <span class="inline-block px-8">${meta.ticker}</span>
                <span class="inline-block px-8">${meta.ticker}</span>
            `;
        }

        function renderPartyEditor() {
            const container = document.getElementById('editor-parties');
            const data = getActiveData();
            
            document.getElementById('editor-data-title').innerText = currentMode === 'presidential' ? 'Kandidaten (Präsident)' : 'Parteien (Parlament)';
            container.innerHTML = '';

            data.forEach((p, index) => {
                const item = document.createElement('div');
                item.className = 'p-3.5 bg-gray-900/80 border border-gray-800 rounded-xl space-y-2.5 shadow';
                item.innerHTML = `
                    <div class="flex justify-between items-center">
                        <span class="text-xs font-bold text-white tech-font">Eintrag #${index + 1}</span>
                        <button onclick="removeParty(${p.id})" class="text-xs text-rose-400 hover:text-rose-300 font-medium">Löschen</button>
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <input type="text" value="${p.name}" onblur="updateParty(${p.id}, 'name', this.value)" class="bg-gray-950 border border-gray-800 p-1.5 text-xs rounded-lg text-white focus:border-sky-500 focus:outline-none" placeholder="Name">
                        <input type="text" value="${p.short}" onblur="updateParty(${p.id}, 'short', this.value)" class="bg-gray-950 border border-gray-800 p-1.5 text-xs rounded-lg text-white focus:border-sky-500 focus:outline-none" placeholder="Kürzel">
                    </div>
                    ${currentMode === 'parliament' ? `
                    <div class="grid grid-cols-2 gap-2">
                        <input type="text" value="${p.block || ''}" onblur="updateParty(${p.id}, 'block', this.value)" class="bg-gray-950 border border-sky-500/30 p-1.5 text-xs rounded-lg text-sky-300 focus:outline-none" placeholder="Block-Name">
                        <input type="text" value="${p.blockShort || ''}" onblur="updateParty(${p.id}, 'blockShort', this.value)" class="bg-gray-950 border border-sky-500/30 p-1.5 text-xs rounded-lg text-sky-300 focus:outline-none" placeholder="Block-Kürzel">
                    </div>` : ''}
                    <div class="grid grid-cols-3 gap-2">
                        <input type="number" value="${p.seats}" onblur="updateParty(${p.id}, 'seats', parseInt(this.value))" class="bg-gray-950 border border-gray-800 p-1.5 text-xs rounded-lg text-white focus:border-sky-500 focus:outline-none" placeholder="Sitze" ${currentMode === 'presidential' ? 'disabled' : ''}>
                        <input type="number" step="0.1" value="${p.pct}" onblur="updateParty(${p.id}, 'pct', parseFloat(this.value))" class="bg-gray-950 border border-gray-800 p-1.5 text-xs rounded-lg text-white focus:border-sky-500 focus:outline-none" placeholder="%">
                        <input type="text" value="${p.diff}" onblur="updateParty(${p.id}, 'diff', this.value)" class="bg-gray-950 border border-gray-800 p-1.5 text-xs rounded-lg text-white focus:border-sky-500 focus:outline-none" placeholder="+/- %">
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <input type="color" value="${p.color}" oninput="updatePartyColorInstant(${p.id}, this.value)" class="w-full h-8 bg-transparent border border-gray-800 rounded-lg cursor-pointer">
                        <input type="text" value="${p.img}" onblur="updateParty(${p.id}, 'img', this.value)" class="bg-gray-950 border border-gray-800 p-1.5 text-xs rounded-lg text-white focus:border-sky-500 focus:outline-none" placeholder="Bild URL (Optional)">
                    </div>
                    <textarea onblur="updateParty(${p.id}, 'ideology', this.value)" class="w-full bg-gray-950 border border-gray-800 p-1.5 text-xs rounded-lg text-white h-14 focus:border-sky-500 focus:outline-none" placeholder="Ideologie">${p.ideology}</textarea>
                `;
                container.appendChild(item);
            });
        }

        function updatePartyColorInstant(id, color) {
            const data = getActiveData();
            const p = data.find(x => x.id === id);
            if (p) {
                p.color = color;
                renderBarsAndIdeology();
                if (currentMode === 'parliament') {
                    if (parliamentStyle === 'arc') renderParliamentChart(false);
                    else renderWestminsterMainGrid();
                    renderBlocks();
                    renderCoalitionButtonsAndChart(false);
                }
            }
        }

        function updateParty(id, key, value) {
            const data = getActiveData();
            const p = data.find(x => x.id === id);
            if (p) {
                p[key] = value;
                renderAll(true);
            }
        }

        function addParty() {
            const data = getActiveData();
            const newId = Date.now();
            data.push({ id: newId, name: 'NEUER EINTRAG', short: 'NEU', seats: currentMode === 'parliament' ? 10 : 0, pct: 5.0, diff: '+0.0%', color: '#38BDF8', img: '', ideology: 'Zentrum', block: 'Neuer Block', blockShort: 'NEU', coalition: false });
            renderAll(true);
        }

        function removeParty(id) {
            if (currentMode === 'presidential') {
                presidentialCandidates = presidentialCandidates.filter(p => p.id !== id);
            } else {
                parliamentParties = parliamentParties.filter(p => p.id !== id);
            }
            renderAll(true);
        }

        function export4K() {
            const exportArea = document.getElementById('export-area');
            html2canvas(exportArea, {
                scale: 2,
                backgroundColor: '#0B0F19',
                useCORS: true
            }).then(canvas => {
                const link = document.createElement('a');
                link.download = `wahl_studio_4k_${Date.now()}.png`;
                link.href = canvas.toDataURL('image/png');
                link.click();
            });
        }
    </script>
</body>
</html>
