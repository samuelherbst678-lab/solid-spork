                    <div id="coalition-arc-wrapper" class="relative w-[340px] h-[180px] flex justify-center items-center">
                        <canvas id="coalitionChart"></canvas>
                    </div>

                    <!-- COALITION WESTMINSTER CONTAINER -->
                    <div id="coalition-westminster-wrapper" class="hidden flex-col items-center justify-center w-full max-w-4xl py-4">
                        <div class="flex items-center gap-4 w-full">
                            <div class="flex flex-col items-center justify-center border border-gray-800 p-2.5 rounded-lg bg-gray-900 shadow-inner">
                                <div class="w-4 h-4 rounded-full bg-amber-400 mb-1 shadow-[0_0_8px_rgba(251,191,36,0.5)]"></div>
                                <span class="text-[9px] font-bold tech-font text-gray-400 uppercase">SPEAKER</span>
                            </div>
                            <div class="flex-1 flex flex-col gap-4">
                                <div class="flex flex-col gap-1 bg-gray-900/60 p-3 rounded-lg border border-gray-800">
